-- modules to install
modules = Unfezant.Engine.Promise
        , Unfezant.Engine.Eff
        , Unfezant.Engine.Dom
        , Unfezant.Engine.Application
        , Unfezant.Engine.Ticker
        , Unfezant.Engine.Container
        , Unfezant.Engine.Graphics
        , Unfezant.Engine.Assets
        , Unfezant.Engine.Sprite
        , Unfezant.Engine.Color
        , Unfezant.Engine

-- main file (i.e. file to load at REPL)
main = Main

-- name of executable
executable = "main.js"
opts = "--cg javascript --directive pretty"
sourcedir = "src"
